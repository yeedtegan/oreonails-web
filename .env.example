# Image-generation service (POST /generate-image, multipart: image + prompt)
IMAGE_API_URL=
IMAGE_API_URL=
# Same token as IMAGE_API_TOKEN on oreonails-api (needed when that server listens beyond 127.0.0.1)
IMAGE_API_TOKEN=

# Sign in with Google — the SAME OAuth Client ID as GOOGLE_CLIENT_ID on oreonails-api.
# Google Cloud Console → Credentials → OAuth client (Web application) → Authorized JavaScript origins: this site's URL.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public URL of this site (Whop sends customers back to <SITE_URL>/checkout/result). Defaults to the request origin.
SITE_URL=
# Whop webhook → https://<SITE_URL>/api/whop/webhook (event payment.succeeded); verified by oreonails-api.
